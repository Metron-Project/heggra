#, python-format
msgid "The file can't be larger than %(size)s."
msgstr "Il file non può superare %(size)s."

msgid "This page has expired. Reload it to upload files."
msgstr "Questa pagina è scaduta. Ricaricala per caricare i file."

msgid "Log in to upload files."
msgstr "Accedi per caricare i file."

msgid "No file was submitted."
msgstr "Non è stato inviato alcun file."

msgid "Choose a file…"
msgstr "Scegli un file…"

msgid "or drop it here"
msgstr "o trascinalo qui"

msgid "Remove"
msgstr "Rimuovi"

msgid "The upload failed. Please try again."
msgstr "Il caricamento non è riuscito. Riprova."

msgid "The uploaded file is no longer available. Please upload it again."
msgstr "Il file caricato non è più disponibile. Caricalo di nuovo."
